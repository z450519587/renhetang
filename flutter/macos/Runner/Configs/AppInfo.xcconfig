// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// Keep the bundle file name as RustDesk.app: build scripts and daemon plist paths
// hardcode this name. The user-visible app name is set below via CFBundleDisplayName.
PRODUCT_NAME = RustDesk
INFOPLIST_KEY_CFBundleDisplayName = 仁和堂专用远程工具
INFOPLIST_KEY_CFBundleName = 仁和堂专用远程工具

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.carriez.flutterHbb

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Purslane Tech Pte. Ltd. All rights reserved.
